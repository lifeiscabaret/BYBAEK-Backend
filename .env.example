# ─────────────────────────────────────────────
# Azure OpenAI (임베딩 · 비전 · RAG · 사진 필터)
# ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_MINI=
AZURE_OPENAI_DEPLOYMENT_FULL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ─────────────────────────────────────────────
# Claude (Azure AI Foundry, Anthropic SDK) — 생성/분석/챗
#   base_url 형식: https://<foundry-resource>.services.ai.azure.com/anthropic
# ─────────────────────────────────────────────
AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_KEY=
# Claude 호출 전체가 쓰는 모델 식별자 (post_writer · insta_analyzer ·
# photo_select · custom_chat 4개 파일, 총 5곳).
# 비워두면 claude-sonnet-4-6. 모델을 바꿔 테스트할 때만 값을 넣는다.
# (Foundry에 배포된 실제 식별자를 그대로 적을 것 — 포털의 배포 목록에서 확인)
CLAUDE_MODEL_NAME=

# ─────────────────────────────────────────────
# Cosmos DB (문서 + 벡터 검색)
# ─────────────────────────────────────────────
AZURE_COSMOS_URL=
AZURE_COSMOS_KEY=

# ─────────────────────────────────────────────
# Blob Storage / Queue (사진 파이프라인)
# ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=photos

# ─────────────────────────────────────────────
# Microsoft Entra ID (App Service Easy Auth · OneDrive/Graph)
# ─────────────────────────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ONEDRIVE_CLIENT_ID=

# ─────────────────────────────────────────────
# Instagram (Meta) OAuth — 소문자 주의 (코드가 os.getenv("client_id") 등으로 읽음)
#   redirect_uri 는 Meta 앱 등록값·프론트 authorize 값과 문자까지 동일해야 함
# ─────────────────────────────────────────────
client_id=
client_secret=
redirect_uri=
INSTAGRAM_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# 기타
# ─────────────────────────────────────────────
TAVILY_API_KEY=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
